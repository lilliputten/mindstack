# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.swc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.SAMPLE

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Misc
/.contentlayer
/.dependencygraph
/certificates
/src/generated/prisma

# Cosmos
cosmos.imports.ts
.cosmos-export

# Temporariy, swap & ignored files
/bin
/log*.txt
/config-local.*
/*.session
*UNUSED
*~
# *_
# !*__
.*.sw?
*.tmp
*.zip
*.tgz
*.log
