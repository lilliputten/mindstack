// vim: fdm=indent

generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "zod-prisma-types"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id @default(cuid())
  type              String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  provider          String
  providerAccountId String   @map("provider_account_id")
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  expires      DateTime
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole  @default(USER)
  grade         UserGrade @default(BASIC)

  // TODO: Issue #79: Track last sign-in time
  lastSignedIn DateTime? @map("last_signed_in")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptionPeriod    UserSubscriptionPeriod? @map("subscription_period")
  subscriptionStartedAt DateTime?               @updatedAt @map("subscription_started_at")

  accounts         Account[]
  AIGenerations    AIGeneration[]
  sessions         Session[]
  topics           Topic[]
  userPayments     UserPayment[]
  userSettings     UserSettings?
  userTopicWorkout UserTopicWorkout[]
  workoutStats     WorkoutStats[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  name       String?
  locale     String?
  image      String?

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserPayment {
  userId           String              @map("user_id")
  provider         UserPaymentProvider @default(YOOKASSA)
  paymentId        String              @map("payment_id")
  uniqueKey        String              @map("unique_key")
  status           UserPaymentStatus
  subscriptionType String              @map("subscription_type")
  currency         CurrencyType
  price            Float
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, paymentId, uniqueKey], map: "user_provider_payment_unique")
  @@index([userId, provider, uniqueKey, createdAt], map: "user_provider_unique_created")
  @@index([status, createdAt], map: "status_created")
  @@map("user_payments")
}

model TelegramSession {
  key   String @id @unique
  value String

  @@map("telegram_session")
}

model AllowedUser {
  id    Int             @id @default(autoincrement())
  type  AllowedUserType @default(EMAIL)
  value String          @default("")

  @@unique([type, value])
  @@map("allowed_users")
}

model UserSettings {
  userId           String   @id @map("user_id")
  showOnlyMyTopics Boolean? @default(false) @map("show_only_my_topics")
  locale           String?  @map("locale")
  theme            String?  @map("theme")
  themeColor       String?  @map("theme_color")
  langCode         String?  @map("lang_code")
  langName         String?  @map("lang_name")
  langCustom       Boolean? @map("lang_custom")

  // TODO: Issue #79: "Show my achievements publicly"
  exposeAchievements Boolean @default(false) @map("expose_achievements")

  // Is it used?
  jumpToNewEntities Boolean? @default(false) @map("jump_to_new_entities")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}

model AIGeneration {
  id String @id @default(cuid())

  // TODO: Issue #79: Mark debug-mode generations
  debugMode Boolean @default(false)

  modelUsed String? @map("model_used")

  spentTimeMs Int @default(0) @map("spent_time_ms")
  spentTokens Int @default(0) @map("spent_tokens")

  // Track related topic, if applicable
  topicId String? @map("topic_id")

  createdAt  DateTime @default(now()) @map("created_at")
  finishedAt DateTime @default(now()) @map("finished_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_generations")
}

model Category {
  id           String                @id @default(cuid())
  status       CategoryStatus        @default(PUBLIC)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")
  createdBy    String?               @map("created_by")
  imageUrl     String?               @map("image_url")
  updatedBy    String?               @map("updated_by")
  translations CategoryTranslation[]
  topics       Topic[]               @relation("CategoryToTopic")

  @@index([status])
  @@map("categories")
}

model CategoryTranslation {
  categoryId  String
  locale      String
  name        String
  description String?
  keywords    String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Topic {
  id String @id @default(cuid())

  name        String
  description String?
  keywords    String?

  isPublic Boolean? @map("is_public")

  // TODO: Issue #79: Default "extra" text to use for AI generation
  extraQuery String @default("") @map("extra_query")

  langCode   String?  @map("lang_code")
  langName   String?  @map("lang_name")
  langCustom Boolean? @map("lang_custom")

  answersCountRandom Boolean? @map("answers_count_random")
  answersCountMin    Int?     @map("answers_count_min")
  answersCountMax    Int?     @map("answers_count_max")

  userId String @map("user_id")

  questions        Question[]
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userTopicWorkout UserTopicWorkout[]
  workoutStats     WorkoutStats[]
  categories       Category[]         @relation("CategoryToTopic")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@map("topics")
}

model Question {
  id String @id @default(cuid())

  // TODO: Issue #79: Order parameter to allow re-order the items
  order Int?

  text String

  isGenerated Boolean @default(false) @map("is_generated")

  // TODO: Issue #79: Default "extra" text to use for AI generation
  extraQuery String @default("") @map("extra_query")

  answersCountRandom Boolean? @map("answers_count_random")
  answersCountMin    Int?     @map("answers_count_min")
  answersCountMax    Int?     @map("answers_count_max")

  topicId String @map("topic_id")

  answers Answer[]
  topic   Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([topicId])
  @@map("questions")
}

model Answer {
  id String @id @default(cuid())

  // TODO: Issue #79: Order parameter to allow re-order the items
  order Int?

  text        String
  explanation String?

  isCorrect   Boolean @default(false) @map("is_correct")
  isGenerated Boolean @default(false) @map("is_generated")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  questionId String @map("question_id")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("answers")
}

model UserTopicWorkout {
  userId           String         @map("user_id")
  topicId          String         @map("topic_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")
  startedAt        DateTime?      @map("started_at")
  finishedAt       DateTime?      @map("finished_at")
  questionsCount   Int?           @map("questions_count")
  questionsOrder   String?        @map("questions_order")
  questionResults  String?        @map("question_results")
  stepIndex        Int?           @map("step_index")
  selectedAnswerId String?        @map("selected_answer_id")
  currentRatio     Int?           @map("current_ratio")
  currentTime      Int?           @map("current_time")
  correctAnswers   Int?           @map("correct_answers")
  started          Boolean        @default(false)
  finished         Boolean        @default(false)
  topic            Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutStats     WorkoutStats[]

  @@id([userId, topicId])
  @@map("user_topic_workouts")
}

model WorkoutStats {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  topicId        String           @map("topic_id")
  totalQuestions Int              @map("total_questions")
  correctAnswers Int              @map("correct_answers")
  ratio          Int
  timeSeconds    Int              @map("time_seconds")
  startedAt      DateTime         @map("started_at")
  finishedAt     DateTime         @map("finished_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  topic          Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout        UserTopicWorkout @relation(fields: [userId, topicId], references: [userId, topicId], onDelete: Cascade)

  @@index([userId])
  @@index([topicId])
  @@index([userId, topicId])
  @@map("workout_stats")
}

model Currency {
  id            Int          @id @default(autoincrement())
  type          CurrencyType @unique @default(USD)
  ratio         Float
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")
  updatingSince DateTime?    @map("updating_since")

  @@map("currencies")
}

enum UserRole {
  USER
  ADMIN
}

enum UserGrade {
  GUEST
  BASIC
  PRO
  PREMIUM
  UNLIMITED
}

enum UserSubscriptionPeriod {
  MONTH
  YEAR
}

enum UserPaymentProvider {
  YOOKASSA
  STRIPE
}

enum UserPaymentStatus {
  PENDING
  FAILED
  SUCCEED
  CANCELED
}

enum AllowedUserType {
  EMAIL
  TELEGRAM
}

enum CategoryStatus {
  PUBLIC
  SUGGESTED
  HIDDEN
}

enum CurrencyType {
  USD
  RUB
  TGSTAR
  EUR
}
